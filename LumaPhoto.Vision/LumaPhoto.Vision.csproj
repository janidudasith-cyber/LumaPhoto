<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Deliberately NO <UseWPF>. This assembly must stay UI-framework agnostic
         so the standalone batch tool can reference it without dragging in WPF. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />

    <!-- Swap the line above for this one to get GPU inference on Windows.
         DirectML works on AMD/Intel/NVIDIA and needs no CUDA install.
         The code falls back to CPU automatically if the provider is missing. -->
    <!-- <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.19.2" /> -->
  </ItemGroup>

  <ItemGroup>
    <!-- Any .onnx here is copied next to the exe for local testing of the
         auto-select path (EnsureRemover picks the best model present). Only
         u2netp.onnx (~5 MB) actually ships — see installer.iss; the heavier
         group-photo / hair models are an in-app on-demand download (ModelDownloader).
         ExcludeFromSingleFile keeps each model a loose file next to the exe so
         AppContext.BaseDirectory resolution still works in a single-file publish. -->
    <Content Include="Assets\Models\**\*.onnx" Condition="Exists('Assets\Models')">
      <Link>Assets\Models\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
