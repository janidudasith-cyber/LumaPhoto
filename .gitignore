# Build outputs — pattern applies to every project, not just LumaPhoto/
bin/
obj/
publish/
publish_*/
installer_output/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Training data & checkpoints (too large for git)
training/data/
training/checkpoints*/
*.pt
*.onnx

# Dev stash for the big optional models. Kept OUT of Assets\Models so the build
# doesn't copy ~350 MB into every output folder — only u2netp.onnx ships, and
# ModelDownloader fetches the rest at runtime. Copy one in from here to test
# the auto-select path without re-downloading.
.models-cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vs/
*.user
*.suo

# Claude Code — per-machine permissions, not shared
.claude/settings.local.json

# Personal / scratch artifacts (never publish)
*.docx
*.zip
*.log
training/*.log
